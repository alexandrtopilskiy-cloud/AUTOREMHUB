APP_NAME="Маркетплейс СТО API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173
SERVICE_TIMEZONE=Europe/Moscow
VISIT_TIME_START=08:00
VISIT_TIME_END=22:00
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sto
DB_USERNAME=sto_api
DB_PASSWORD=
DB_SCHEMA=sto_api
DB_SSLMODE=prefer
SESSION_COOKIE=sto_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
BCRYPT_ROUNDS=12
LOG_LEVEL=warning
DOCUMENT_LOCK_TTL_SECONDS=120

# Private S3-compatible object storage. No public bucket is required.
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_REGION=us-east-1
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_PATH_STYLE=false
# Optional CloudFront-compatible signed CDN. Without this, signed S3 URLs are returned.
MEDIA_CDN_URL=
MEDIA_CDN_KEY_PAIR_ID=
MEDIA_CDN_PRIVATE_KEY_PATH=
