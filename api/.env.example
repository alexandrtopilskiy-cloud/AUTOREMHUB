APP_NAME="Маркетплейс СТО API"
APP_ENV=local
APP_KEY=
# Старые ключи через запятую (после смены APP_KEY, чтобы читались зашифрованные пароли ЭДО)
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173
SERVICE_TIMEZONE=Europe/Moscow

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=

VISIT_TIME_START=08:00
VISIT_TIME_END=22:00

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sto
DB_USERNAME=sto_api
DB_PASSWORD=
DB_SCHEMA=sto_api
DB_SSLMODE=prefer
# Вместо DB_* можно задать одной строкой: DB_URL=pgsql://user:pass@host:5432/db
DB_URL=

SESSION_COOKIE=sto_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_DRIVER=array

CACHE_STORE=database
FILESYSTEM_DISK=media
BCRYPT_ROUNDS=12
LOG_LEVEL=debug

DOCUMENT_LOCK_TTL_SECONDS=120

QUEUE_CONNECTION=database
DB_LOG_QUERIES=false

# ─── ЭДО ─────────────────────────────────────────────────────
# Оператор: none | sbis | edoru | diadoc | sberkorus | taxcom.
# Логин и пароль СБИС у каждой организации вводятся в интерфейсе:
# «Документы ЭДО» → ⚙️ (не в .env).
EDO_PROVIDER=sbis
# true — документы не уходят оператору (тестовый режим, реестр ЭДО пуст).
EDO_MOCK=true
# Очередь закрывающих документов (ЗН, Счёт, УПД): queue:work --queue=edo
EDO_QUEUE=edo
# Подписание УКЕП: stub — заглушка на время отладки (только ПодготовитьДействие
# в СБИС, без подписи и отправки); cryptopro — КриптоПро ЭЦП Browser plug-in.
EDO_SIGNING=stub
EDO_LOG_LEVEL=info
EDO_MANAGER_MARKUP_PERCENT=10

# СБИС (JSON-RPC API)
SBIS_BASE_URL=https://online.sbis.ru/service/?srv=1
SBIS_AUTH_URL=https://online.sbis.ru/auth/service/
SBIS_TIMEOUT=30
SBIS_CONNECT_TIMEOUT=10

# ЭДО.ру (ЭДО.Поток) — только при EDO_PROVIDER=edoru
EDO_EDORU_BASE_URL=https://lk.edo.ru/api/edo/v1
EDO_EDORU_AUTH_MODE=auth-global
EDO_EDORU_CLIENT_ID=
EDO_EDORU_PASSWORD=
EDO_EDORU_FINGERPRINT=
EDO_EDORU_TIMEOUT=30
EDO_EDORU_CONNECT_TIMEOUT=10

# Диадок — только при EDO_PROVIDER=diadoc
DIADOC_BASE_URL=https://diadoc-api.kontur.ru
DIADOC_CLIENT_ID=
DIADOC_CLIENT_SECRET=

# Такском — только при EDO_PROVIDER=taxcom
TAXCOM_BASE_URL=https://api.taxcom.ru/v1.0
TAXCOM_INTEGRATOR_ID=

# Входящий webhook оператора (задел, пока не используется)
EDO_WEBHOOK_ENABLED=false
EDO_WEBHOOK_SECRET=
