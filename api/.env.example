APP_NAME="Маркетплейс СТО API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173
SERVICE_TIMEZONE=Europe/Moscow

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SANCTUM_EXPIRATION=1440

VISIT_TIME_START=08:00
VISIT_TIME_END=22:00

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sto
DB_USERNAME=sto_api
DB_PASSWORD=
DB_SCHEMA=sto_api
DB_SSLMODE=prefer

SESSION_COOKIE=sto_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_DRIVER=array

CACHE_STORE=database
BCRYPT_ROUNDS=12
LOG_LEVEL=debug

DOCUMENT_LOCK_TTL_SECONDS=120

QUEUE_CONNECTION=database
DB_LOG_QUERIES=false

# ─── ЭДО ─────────────────────────────────────────────────────
EDO_PROVIDER=edoru

EDO_EDORU_BASE_URL=https://lk.edo.ru/api/edo/v1
EDO_EDORU_AUTH_MODE=auth-global
EDO_EDORU_CLIENT_ID=
EDO_EDORU_PASSWORD=
EDO_EDORU_TIMEOUT=30
EDO_EDORU_CONNECT_TIMEOUT=10

DIADOC_BASE_URL=https://diadoc-api.kontur.ru

EDO_MOCK=true