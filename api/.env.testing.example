# ─── Прочее ───
BCRYPT_ROUNDS=4
FRONTEND_ORIGINS=http://localhost:5173
SESSION_SECURE_COOKIE=false

# ─── Файлы — в fake-диск в тестах ───
FILESYSTEM_DISK=local
