# AUTOREMHUB 0.38.1 — пример api/.env для сервера.
# Скопируйте в api/.env и замените значения в <...>. Файл .env в архив не входит.
APP_NAME="Маркетплейс СТО API"
APP_ENV=production
# Заполняется командой php artisan key:generate ТОЛЬКО при первой установке.
APP_KEY=
APP_DEBUG=false
APP_URL=https://<ваш-домен>
# Адрес, с которого открывается интерфейс (тот же домен, если Front и API на одном).
FRONTEND_ORIGINS=https://<ваш-домен>
SERVICE_TIMEZONE=Europe/Moscow
VISIT_TIME_START=08:00
VISIT_TIME_END=22:00

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sto
DB_USERNAME=sto_api
DB_PASSWORD=<пароль-пользователя-sto_api>
DB_SCHEMA=sto_api
DB_SSLMODE=prefer

SESSION_COOKIE=sto_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
BCRYPT_ROUNDS=12
LOG_LEVEL=warning
DOCUMENT_LOCK_TTL_SECONDS=120

# Вложения в 0.38.1 хранятся на локальном диске api/storage/app/media
# (S3 в коде не подключён). Переменные MEDIA_* пока не используются.
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_REGION=us-east-1
MEDIA_BUCKET=
MEDIA_ENDPOINT=
MEDIA_PATH_STYLE=false
MEDIA_CDN_URL=
MEDIA_CDN_KEY_PAIR_ID=
MEDIA_CDN_PRIVATE_KEY_PATH=
