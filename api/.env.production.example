# AUTOREMHUB 0.45.003 — пример api/.env для сервера.
# На сервере файл лежит в shared/.env (общий для всех релизов, в архив не входит).
# Замените значения в <...>. После правки: php artisan config:cache и queue:restart
# (деплой делает это сам).
APP_NAME="Маркетплейс СТО API"
APP_ENV=production
# Заполняется командой php artisan key:generate ТОЛЬКО при первой установке.
APP_KEY=
# Старые ключи через запятую: нужны после смены APP_KEY, иначе не прочитаются
# зашифрованные пароли и сессии ЭДО организаций.
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://<ваш-домен>
# Адрес, с которого открывается интерфейс (тот же домен, если Front и API на одном).
FRONTEND_ORIGINS=https://<ваш-домен>
SERVICE_TIMEZONE=Europe/Moscow
VISIT_TIME_START=08:00
VISIT_TIME_END=22:00

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sto
DB_USERNAME=sto_api
DB_PASSWORD=<пароль-пользователя-sto_api>
DB_SCHEMA=sto_api
DB_SSLMODE=prefer

SESSION_COOKIE=sto_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
# Очередь — в БД, воркер очереди edo запускает supervisor
# (/etc/supervisor/conf.d/autoremhub-edo.conf):
#   php artisan queue:work --queue=edo --sleep=3 --tries=3 --max-time=3600
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12
LOG_LEVEL=warning
DOCUMENT_LOCK_TTL_SECONDS=120

# Вложения хранятся на локальном диске api/storage/app/media (shared/storage).
FILESYSTEM_DISK=media
# Подписанные ссылки CDN (пока не используются).
MEDIA_CDN_URL=
MEDIA_CDN_KEY_PAIR_ID=
MEDIA_CDN_PRIVATE_KEY_PATH=

# ─── ЭДО ─────────────────────────────────────────────────────
# Логин и пароль СБИС у каждой организации — в интерфейсе «Документы ЭДО» → ⚙️.
EDO_PROVIDER=sbis
# false — документы реально записываются в СБИС.
EDO_MOCK=false
EDO_QUEUE=edo
# stub — заглушка подписания на время отладки (ПодготовитьДействие без подписи
# и отправки); cryptopro — подпись КриптоПро в браузере и отправка получателю.
EDO_SIGNING=stub
EDO_LOG_LEVEL=info
EDO_MANAGER_MARKUP_PERCENT=10
SBIS_BASE_URL=https://online.sbis.ru/service/?srv=1
SBIS_AUTH_URL=https://online.sbis.ru/auth/service/
SBIS_TIMEOUT=30
SBIS_CONNECT_TIMEOUT=10

# Изменения документов СБИС забирает планировщик (edo:sbis-changes, раз в 2 мин).
# Нужен cron от www-data:
#   * * * * * php /var/www/autoremhub/current/api/artisan schedule:run >> /dev/null 2>&1
